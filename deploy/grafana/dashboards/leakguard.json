{
 "title": "LeakGuard",
 "uid": "leakguard",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests (5m)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(leakguard_requests_total[5m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Block rate (5m)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(leakguard_requests_total{action=\"block\"}[5m])) / clamp_min(sum(increase(leakguard_requests_total[5m])),1)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Pending human reviews",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "leakguard_hitl_pending"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Fail-closed events (1h)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(leakguard_fail_closed_total[1h]))"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Decisions by action",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (action) (rate(leakguard_requests_total[5m]))",
     "legendFormat": "{{action}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Guard latency p50 / p95",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(leakguard_latency_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(leakguard_latency_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Findings by entity",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (entity) (rate(leakguard_findings_total[5m]))",
     "legendFormat": "{{entity}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Tool calls by status",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tool, status) (rate(leakguard_tool_calls_total[5m]))",
     "legendFormat": "{{tool}} {{status}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Per-node latency p95",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, node) (rate(leakguard_stage_latency_seconds_bucket[5m])))",
     "legendFormat": "{{node}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Escalations & overrides",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(leakguard_escalations_total[15m]))",
     "legendFormat": "esc {{reason}}"
    },
    {
     "refId": "B",
     "expr": "sum(rate(leakguard_hitl_overrides_total[15m]))",
     "legendFormat": "overrides"
    }
   ]
  }
 ]
}