# Copy to .env and fill in. Everything is optional: with no keys LeakGuard runs fully offline with mocks.
LG_DATABASE_URL=sqlite:///leakguard.db            # or postgresql+psycopg://user:pass@host:5432/db (Neon)
LG_VAULT_KEY=                                      # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# downstream chat LLM (OpenAI-compatible): mock | groq | nim | ollama | openai_compat
LG_LLM_PROVIDER=mock
LG_LLM_API_KEY=
LG_LLM_MODEL=                                      # default per provider (groq: llama-3.3-70b-versatile)

# models
LG_USE_GLINER=true
LG_GLINER_MODEL=urchade/gliner_multi_pii-v1
LG_GLINER_THRESHOLD=0.45
LG_USE_LAYA=true
LG_LAYA_MODEL=convaiinnovations/laya-multilingual
LG_LAYA_RESIDUAL_THRESHOLD=1.01                    # >1 disables the residual check (hurt FBR on dev)

# guardrails / ops
LG_SHADOW_MODE=false
LG_API_KEY=                                        # if set, every API call needs X-API-Key
LG_ALERT_WEBHOOK_URL=                              # Slack/Teams incoming webhook for block/escalate alerts
